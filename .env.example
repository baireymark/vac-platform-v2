# Copy to .env and fill in. Never commit .env.
# All variables here are server-only (SMTP). Next.js only exposes variables prefixed NEXT_PUBLIC_ to the browser;
# never give an SMTP_* or MAIL_* variable that prefix. PORT is used by `npm run start:legacy` only (Next uses -p 4174).
PORT=4174

# SMTP server (e.g. Google Workspace: smtp.gmail.com / 465 / secure=true with an App Password;
# Microsoft 365: smtp.office365.com / 587 / secure=false)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me

# Sender shown on the email (must be allowed by your SMTP account)
MAIL_FROM="VAC Website <no-reply@example.com>"
# Where form submissions go (comma-separate for several)
MAIL_TO=info@vac2023.com
